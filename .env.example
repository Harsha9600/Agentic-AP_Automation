APP_INPUT_DIR=inputs
APP_OUTPUT_DIR=outputs
APP_WORK_DIR=.work
PDF_RENDER_DPI=300
IMAGE_MAX_SIDE=1800
PROMPT_FILE=prompts/invoice_extraction_prompt.md
LLM_PROVIDER=grok

# xAI Grok (paid API; separate from Groq's free API).
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL_ID=grok-4.7
GROK_MAX_TOKENS=8000
GROK_TEMPERATURE=0
GROK_TIMEOUT_SECONDS=180
GROK_REASONING_EFFORT=low

# OCI Generative AI Inference using local OCI config file auth.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..replace_me
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=ocid1.generativeaimodel.oc1.region.replace_me
OCI_GENAI_MAX_TOKENS=4000
OCI_GENAI_TEMPERATURE=0

# Used by the copied MTI barcode code when OCR fallback is needed.
TESSERACT_CMD=tesseract
